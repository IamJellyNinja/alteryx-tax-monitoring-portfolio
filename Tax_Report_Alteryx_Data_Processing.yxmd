        <Node ToolID="6">
          <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
            <Position x="678" y="330" />
          </GuiSettings>
          <Properties>
            <Configuration>
              <FormulaFields>
                <FormulaField expression="&#xA;IIF(IsNull([record_id]) OR IsEmpty(Trim([record_id])),&#xA;&quot;MISSING_RECORD_ID; &quot;,&quot;&quot;)&#xA;+&#xA;IIF(!IsNull([record_id]) AND !IsEmpty(Trim([record_id]))&#xA;AND [record_id] != UpperCase(Trim([record_id])),&#xA;&quot;RECORD_ID_FORMAT; &quot;,&quot;&quot;)&#xA;+&#xA;IIF(!REGEX_Match(UpperCase(Trim([record_id])),&quot;^REC[0-9]{6}$&quot;),&#xA;&quot;INVALID_RECORD_ID; &quot;,&quot;&quot;)&#xA;&#xA;+&#xA;&#xA;IIF(IsNull([filing_id]) OR IsEmpty(Trim([filing_id])),&#xA;&quot;MISSING_FILING_ID; &quot;,&quot;&quot;)&#xA;+&#xA;IIF(!REGEX_Match(UpperCase(Trim([filing_id])),&quot;^F[0-9]{6}$&quot;),&#xA;&quot;INVALID_FILING_ID; &quot;,&quot;&quot;)&#xA;&#xA;+&#xA;&#xA;IIF(IsNull([business_id]) OR IsEmpty(Trim([business_id])),&#xA;&quot;MISSING_BUSINESS_ID; &quot;,&quot;&quot;)&#xA;+&#xA;IIF(!IsNull([business_id]) AND !IsEmpty(Trim([business_id]))&#xA;AND [business_id] != UpperCase(Trim([business_id])),&#xA;&quot;BUSINESS_ID_FORMAT; &quot;,&quot;&quot;)&#xA;+&#xA;IIF(!REGEX_Match(UpperCase(Trim([business_id])),&quot;^BIZ[0-9]{5}$&quot;),&#xA;&quot;INVALID_BUSINESS_ID; &quot;,&quot;&quot;)&#xA;&#xA;+&#xA;&#xA;IIF(IsNull([tax_period]) OR IsEmpty(Trim([tax_period])),&#xA;&quot;MISSING_TAX_PERIOD; &quot;,&quot;&quot;)&#xA;+&#xA;IIF(!REGEX_Match(Trim([tax_period]),&quot;^[0-9]{4}-Q[1-4]$&quot;),&#xA;&quot;INVALID_TAX_PERIOD; &quot;,&quot;&quot;)&#xA;&#xA;+&#xA;&#xA;IIF(IsNull([submission_date]) OR IsEmpty(Trim([submission_date])),&#xA;&quot;MISSING_SUBMISSION_DATE; &quot;,&quot;&quot;)&#xA;+&#xA;IIF(&#xA;!IsNull([submission_date])&#xA;AND !IsEmpty(Trim([submission_date]))&#xA;AND IsNull(DateTimeParse([submission_date],&quot;%Y-%m-%d&quot;))&#xA;AND IsNull(DateTimeParse([submission_date],&quot;%d/%m/%Y&quot;))&#xA;AND IsNull(DateTimeParse([submission_date],&quot;%d-%b-%Y&quot;)),&#xA;&quot;INVALID_SUBMISSION_DATE; &quot;,&quot;&quot;)&#xA;+&#xA;IIF(&#xA;!IsNull([submission_date])&#xA;AND !IsEmpty(Trim([submission_date]